# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
JWT_SECRET=

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=college_library_system

# Used by the forgot/reset-password email flow (services/authService.js).
EMAIL_USER=
EMAIL_APP_PASSWORD=
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Only read by db/seed-admin.js — run `node db/seed-admin.js` once to
# create the first Admin account. Not read by the running server, and
# never embedded in frontend code.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
